# Generated by tools/clickhouse_generate.py; edit template and lock.
FROM docker.io/library/golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS build
WORKDIR /src
COPY images/clickhouse/backup/client/go.mod images/clickhouse/backup/client/go.sum ./
RUN go mod download && go mod verify
COPY images/clickhouse/backup/client/ ./
RUN mkdir /licenses \
 && go list -m -f '{{.Path}} {{.Dir}}' all | while read -r name directory; do \
      test -n "$directory" || continue; destination="/licenses/$name"; mkdir -p "$destination"; \
      find "$directory" -maxdepth 1 -type f \( -iname 'license*' -o -iname 'notice*' -o -iname 'copying*' -o -iname 'copyright*' \) -exec cp {} "$destination/" \;; \
    done
RUN test -z "$(gofmt -l *.go)" && go test ./... && go vet ./...
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/clickhouse-sql .
FROM docker.io/library/alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
LABEL org.opencontainers.image.title="ClickHouse client-only backup tools" \
      org.opencontainers.image.version="26.8.28.14" \
      org.opencontainers.image.source="https://github.com/abruncloud/images" \
      org.opencontainers.image.licenses="MIT AND Apache-2.0"
RUN apk upgrade --no-cache \
 && apk add --no-cache ca-certificates curl jq python3 tar gzip coreutils util-linux-misc tini setpriv zip unzip \
 && addgroup -g 10001 backup && adduser -D -u 10001 -G backup backup \
 && mkdir /backup && chown backup:backup /backup && chmod 0700 /backup
COPY --from=build /licenses/ /usr/share/licenses/modules/
COPY LICENSE /usr/share/licenses/clickhouse-sql/LICENSE
COPY --from=build /out/clickhouse-sql /usr/local/bin/clickhouse-sql
COPY images/clickhouse/backup/entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY images/clickhouse/backup/client/go.mod images/clickhouse/backup/client/go.sum /usr/share/clickhouse-sql/
RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh \
 && clickhouse-sql --version | grep -F 'official clickhouse-go/v2 2.49.0' \
 && test -x /sbin/tini && test -x /bin/setpriv \
 && test ! -e /usr/bin/clickhouse && test ! -e /usr/bin/clickhouse-server
USER 10001:10001
WORKDIR /
ENTRYPOINT ["/sbin/tini", "-g", "--", "docker-entrypoint.sh"]
CMD ["clickhouse-sql", "--help"]
