# syntax=docker/dockerfile:1
# Extract only the server-packaged WAL reader from the matching official release.
FROM docker.io/library/postgres:18.6-trixie@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336 AS tools-source
RUN set -eux; \
    mkdir -p /artifact/usr/lib/postgresql/18/bin /artifact/usr/share/doc/postgresql-backup-tools; \
    cp /usr/lib/postgresql/18/bin/pg_waldump /artifact/usr/lib/postgresql/18/bin/; \
    cp /usr/share/doc/postgresql-18/copyright /artifact/usr/share/doc/postgresql-backup-tools/copyright; \
    printf '%s\n' "$PG_VERSION" > /client-package-version

# A clean distro base means no database server is inherited in any final layer.
FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
COPY --from=tools-source /usr/local/share/keyrings/postgres.gpg.asc /usr/local/share/keyrings/postgres.gpg.asc
COPY --from=tools-source /client-package-version /tmp/client-package-version
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates; \
    printf '%s\n' 'deb [signed-by=/usr/local/share/keyrings/postgres.gpg.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main 18' > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        "postgresql-client-18=$(cat /tmp/client-package-version)" \
        liblz4-1 libzstd1 util-linux; \
    rm -rf /var/lib/apt/lists/* /tmp/client-package-version
COPY --from=tools-source /artifact/ /
ENV PATH="/usr/lib/postgresql/18/bin:$PATH"
LABEL org.opencontainers.image.title="PostgreSQL backup tools" \
      org.opencontainers.image.version="18.6" \
      org.opencontainers.image.description="Client-only PostgreSQL logical and physical backup tools" \
      org.opencontainers.image.source="https://github.com/abruncloud/images"
COPY images/postgres/backup/entrypoint.sh /usr/local/bin/postgres-backup
RUN chmod 0555 /usr/local/bin/postgres-backup; \
    for tool in pg_dump pg_dumpall pg_restore pg_basebackup pg_verifybackup psql pg_waldump pg_isready pg_combinebackup; do "$tool" --version; done; \
    command -v setsid
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/postgres-backup"]
CMD ["help"]
