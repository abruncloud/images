# syntax=docker/dockerfile:1
# Select matching native client tools and libpq, without copying system libraries.
FROM docker.io/library/postgres:18.6-alpine3.24@sha256:898c60cb390d1085bc97bdd6a1ae968757421df394b071848b52b1c09c89d6a5 AS tools-source
RUN set -eux; \
    mkdir -p /artifact/usr/local/bin /artifact/usr/local/lib /artifact/usr/share/doc/postgresql-backup-tools; \
    for tool in pg_dump pg_dumpall pg_restore pg_basebackup pg_verifybackup psql pg_waldump pg_isready pg_combinebackup; do cp "/usr/local/bin/$tool" /artifact/usr/local/bin/; done; \
    cp -a /usr/local/lib/libpq.so* /artifact/usr/local/lib/; \
    wget -O /tmp/postgresql.tar.bz2 "https://ftp.postgresql.org/pub/source/v$PG_VERSION/postgresql-$PG_VERSION.tar.bz2"; \
    echo "$PG_SHA256  /tmp/postgresql.tar.bz2" | sha256sum -c -; \
    tar -xOf /tmp/postgresql.tar.bz2 "postgresql-$PG_VERSION/COPYRIGHT" > /artifact/usr/share/doc/postgresql-backup-tools/COPYRIGHT

FROM docker.io/library/alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
COPY --from=tools-source /artifact/ /
# Install the shared-library closure through apk so OS metadata remains accurate.
RUN set -eux; \
    apk add --no-cache --virtual .dependency-scan pax-utils; \
    dependencies="$(scanelf --needed --nobanner --format '%n#p' --recursive /usr/local \
        | tr ',' '\n' | sort -u \
        | awk 'system("[ -e /usr/local/lib/" $1 " ]") == 0 { next } { print "so:" $1 }')"; \
    apk add --no-cache --virtual .postgresql-client-rundeps $dependencies ca-certificates curl jq; \
    apk del --no-network .dependency-scan
LABEL org.opencontainers.image.title="PostgreSQL backup tools" \
      org.opencontainers.image.version="18.6" \
      org.opencontainers.image.description="Client-only PostgreSQL logical and physical backup tools" \
      org.opencontainers.image.source="https://github.com/abruncloud/images"
COPY images/postgres/backup/entrypoint.sh /usr/local/bin/postgres-backup
RUN chmod 0555 /usr/local/bin/postgres-backup; \
    for tool in pg_dump pg_dumpall pg_restore pg_basebackup pg_verifybackup psql pg_waldump pg_isready pg_combinebackup; do "$tool" --version; done; \
    command -v setsid
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/postgres-backup"]
CMD ["help"]
