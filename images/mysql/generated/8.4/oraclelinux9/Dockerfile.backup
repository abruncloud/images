# syntax=docker/dockerfile:1
FROM docker.io/library/mysql:8.4.11-oraclelinux9@sha256:24989179f58856db763f418010c1169fecc944e3ec1ea7e921572d83eb070f70 AS tools-source

# Independent client artifact: the source supplies only its trusted signing key.
FROM docker.io/library/oraclelinux:9-slim@sha256:fdf4581abc841d49f63cf456ea92f8152a80b5bdc62d5409a4e77827b824265c
COPY --from=tools-source /etc/pki/rpm-gpg/RPM-GPG-KEY-mysql /etc/pki/rpm-gpg/RPM-GPG-KEY-mysql
RUN set -eux; \
    printf '%s\n' '[mysql-community-client]' \
      'name=Oracle MySQL 8.4 client packages' \
      'baseurl=https://repo.mysql.com/yum/mysql-8.4-community/el/9/$basearch/' \
      'enabled=1' 'gpgcheck=1' 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-mysql' \
      > /etc/yum.repos.d/mysql-client.repo; \
    rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-mysql; \
    microdnf install -y --setopt=install_weak_deps=0 ca-certificates util-linux curl-minimal jq python3 tar gzip coreutils \
      mysql-community-client-8.4.11-1.el9; \
    microdnf clean all; \
    test "$(rpm -q --qf '%{VERSION}-%{RELEASE}' mysql-community-client)" = '8.4.11-1.el9'; \
    for tool in mysql mysqldump mysqladmin mysqlbinlog; do "$tool" --version; done; \
    for tool in setsid curl jq python3 tar gzip sha256sum wc sed; do command -v "$tool"; done; \
    ! command -v mysqld; \
    ! rpm -qa | grep -E 'mysql-community-server|mariadb'
LABEL org.opencontainers.image.title="MySQL backup clients" \
      org.opencontainers.image.version="8.4.11" \
      org.opencontainers.image.description="Oracle MySQL client-only logical backup tools" \
      org.opencontainers.image.source="https://github.com/abruncloud/images"
COPY images/mysql/backup/entrypoint.sh /usr/local/bin/mysql-backup
RUN chmod 0555 /usr/local/bin/mysql-backup
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/mysql-backup"]
CMD ["help"]
