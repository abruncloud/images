# Generated by tools/mongodb_exporter_generate.py; edit template and security source lock.
FROM {{GO_IMAGE}} AS build
WORKDIR /src
RUN curl --fail --location --retry 3 --output /tmp/source.tar.gz '{{SOURCE_URL}}' \
 && printf '{{SOURCE_SHA256}}  /tmp/source.tar.gz\n' | sha256sum --check --strict \
 && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src
COPY images/mongodb-exporter/security-build/go.mod images/mongodb-exporter/security-build/go.sum ./
ENV GOFLAGS=-mod=readonly GOTOOLCHAIN=local
RUN go mod download && go mod verify
RUN CGO_ENABLED=0 go test ./tools/... ./
RUN mkdir /out /licenses \
 && CGO_ENABLED=0 go build -trimpath \
      -ldflags='-s -w -X main.version=v{{EXPORTER_VERSION}} -X main.commit={{UPSTREAM_COMMIT}} -X main.buildDate=security-source-rebuild' \
      -o /out/mongodb_exporter . \
 && go list -m -f '{{.Path}} {{.Dir}}' all | while read -r name directory; do \
      test -n "$directory" || continue; destination="/licenses/$name"; mkdir -p "$destination"; \
      find "$directory" -maxdepth 1 -type f \( -iname 'license*' -o -iname 'notice*' -o -iname 'copying*' -o -iname 'copyright*' \) -exec cp {} "$destination/" \;; \
    done
FROM {{RUNTIME_BASE_IMAGE}}
LABEL org.opencontainers.image.title="MongoDB exporter with portable diagnostic tools" \
      org.opencontainers.image.version="{{EXPORTER_VERSION}}" \
      org.opencontainers.image.source="https://github.com/abruncloud/images" \
      org.opencontainers.image.licenses="Apache-2.0 AND GPL-2.0-only"
COPY --from=build /out/mongodb_exporter /mongodb_exporter
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /licenses/ /usr/share/licenses/modules/
COPY images/mongodb-exporter/licenses/ /usr/share/licenses/
RUN test -x /bin/busybox && test -x /bin/sh \
 && /bin/busybox --list | grep -Fx nc \
 && /mongodb_exporter --version
USER 65535:65535
EXPOSE 9216
ENTRYPOINT ["/mongodb_exporter"]
