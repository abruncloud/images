FROM docker.io/library/ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5
LABEL org.opencontainers.image.title="MongoDB client-only backup tools" \
      org.opencontainers.image.version="8.0.38" \
      org.opencontainers.image.source="https://github.com/abruncloud/images" \
