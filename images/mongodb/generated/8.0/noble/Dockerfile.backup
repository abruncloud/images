    done
FROM docker.io/library/ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
LABEL org.opencontainers.image.title="MongoDB client-only backup tools" \
      org.opencontainers.image.version="8.0.34" \
      org.opencontainers.image.source="https://github.com/abruncloud/images" \
      org.opencontainers.image.licenses="Apache-2.0"
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends ca-certificates curl jq python3 python3-pymongo python3-yaml tar gzip coreutils util-linux tini libgssapi-krb5-2 libssl3t64 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 imagebackup && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin imagebackup \
