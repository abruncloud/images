# Generated by tools/mongodb_generate.py; edit template and lock.
FROM {{BACKUP_BASE_IMAGE}} AS tools
ARG TARGETARCH
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tar gzip \
 && case "$TARGETARCH" in \
      amd64) url='{{AMD64_URL}}'; checksum='{{AMD64_SHA256}}' ;; \
      arm64) url='{{ARM64_URL}}'; checksum='{{ARM64_SHA256}}' ;; \
      *) exit 1 ;; \
    esac \
 && curl --fail --location --retry 3 --output /tmp/tools.tgz "$url" \
 && printf '%s  /tmp/tools.tgz\n' "$checksum" | sha256sum --check --strict \
 && mkdir /tmp/tools /out /licenses \
 && tar -xzf /tmp/tools.tgz --strip-components=1 -C /tmp/tools \
 && cp /tmp/tools/bin/mongodump /tmp/tools/bin/mongorestore /tmp/tools/bin/bsondump /out/ \
 && find /tmp/tools -maxdepth 1 -type f -exec cp {} /licenses/ \;
FROM {{BACKUP_BASE_IMAGE}}
LABEL org.opencontainers.image.title="MongoDB client-only backup tools" \
      org.opencontainers.image.version="{{MONGODB_VERSION}}" \
      org.opencontainers.image.source="https://github.com/abruncloud/images" \
      org.opencontainers.image.licenses="Apache-2.0"
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends ca-certificates curl jq python3 python3-pymongo python3-yaml tar gzip coreutils util-linux tini libgssapi-krb5-2 libssl3t64 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 backup && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin backup \
 && mkdir /backup && chown backup:backup /backup && chmod 0700 /backup
COPY --from=tools /licenses/ /usr/share/licenses/mongodb-database-tools/
COPY --from=tools /out/ /usr/local/bin/
COPY images/mongodb/backup/entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh \
 && mongodump --version | grep -F 'mongodump version: {{TOOLS_VERSION}}' \
 && mongorestore --version | grep -F 'mongorestore version: {{TOOLS_VERSION}}' \
 && python3 -c 'import pymongo, yaml; print("PyMongo " + pymongo.version)' \
 && test -x /usr/bin/tini && test -x /usr/bin/setpriv \
 && ! command -v mongod && ! command -v mongos && ! command -v mongosh
USER 10001:10001
WORKDIR /
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "docker-entrypoint.sh"]
CMD ["mongodump", "--help"]
