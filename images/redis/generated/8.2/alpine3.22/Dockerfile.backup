FROM docker.io/library/alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f AS build
RUN apk upgrade --no-cache \
 && apk add --no-cache build-base linux-headers openssl-dev curl ca-certificates python3
WORKDIR /usr/src/redis
RUN curl --fail --location --retry 3 --output /tmp/redis.tar.gz https://github.com/redis/redis/archive/refs/tags/8.2.10.tar.gz \
 && echo "d6de0ec3bce8eeba13ecbd7478dd56fb87a4bbe8ec832dd876892a86ac1a55ec  /tmp/redis.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/redis.tar.gz --strip-components=1 \
 && mkdir /source \
 && mv /tmp/redis.tar.gz /source/redis-8.2.10.tar.gz
# Upstream bundles the RDB checker in redis-server and dispatches by basename.
# Force checker dispatch before parsing server flags; even renaming cannot serve.
COPY images/redis/backup/restrict-checker.py /tmp/restrict-checker.py
RUN python3 /tmp/restrict-checker.py src/server.c \
 && make -C src -j "$(getconf _NPROCESSORS_ONLN)" BUILD_TLS=yes BUILD_WITH_MODULES=no MALLOC=libc REDIS_CFLAGS= REDIS_LDFLAGS= redis-cli redis-server \
 && mkdir /out \
 && cp src/redis-cli /out/redis-cli \
 && cp src/redis-server /out/redis-check-rdb \
 && strip /out/redis-cli /out/redis-check-rdb
FROM docker.io/library/alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f
LABEL org.opencontainers.image.title="Redis client and RDB backup tools" \
      org.opencontainers.image.version="8.2.10" \
      org.opencontainers.image.source="https://github.com/abruncloud/images" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
RUN apk upgrade --no-cache \
 && apk add --no-cache ca-certificates libssl3 libcrypto3 curl jq python3 tar gzip coreutils util-linux-misc tini setpriv \
 && addgroup -g 10001 backup \
 && adduser -D -u 10001 -G backup backup \
 && mkdir /backup && chown backup:backup /backup
COPY --from=build /out/ /usr/local/bin/
COPY --from=build /usr/src/redis/LICENSE.txt /usr/share/licenses/redis/LICENSE.txt
COPY --from=build /source/ /usr/share/redis-source/
COPY images/redis/backup/restrict-checker.py images/redis/generated/8.2/alpine3.22/Dockerfile.backup /usr/share/redis-source/
COPY images/redis/backup/entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh \
 && redis-cli --version | grep -Fx 'redis-cli 8.2.10' \
 && test -x /sbin/tini && test -x /bin/setpriv \
 && test ! -e /usr/local/bin/redis-server
USER 10001:10001
WORKDIR /backup
ENTRYPOINT ["/sbin/tini", "-g", "--", "docker-entrypoint.sh"]
CMD ["redis-cli", "--help"]
